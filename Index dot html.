<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ClearTime</title>
<style>
:root{--bg:#f4f7fb;--card:#fff;--text:#172033;--muted:#667085;--line:#d9e0ea;--blue:#2f6fed;--soft:#eaf1ff}
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--text)}
.wrap{max-width:780px;margin:auto;padding:18px 14px 40px}
h1{font-size:30px;margin:4px 0}h2{font-size:19px;margin:0 0 14px}p{color:var(--muted)}
.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;margin:14px 0;box-shadow:0 6px 20px #1720330d}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:620px){.grid{grid-template-columns:1fr}}
label{font-size:13px;font-weight:600;display:block}
input,select,button{font:inherit;border-radius:12px;border:1px solid var(--line);padding:12px 13px;background:#fff;color:var(--text);min-height:46px}
input,select{width:100%}
.types{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.types button{font-weight:700}
.types button.active,.switch button.active{background:var(--soft);border-color:var(--blue);color:#17469c}
.switch{display:flex;gap:8px;margin:8px 0}.switch button{padding:8px 12px;min-height:38px}
.primary{background:var(--blue);color:#fff;border:0;font-weight:700}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
@media(max-width:620px){.stats{grid-template-columns:1fr}}
.stat{padding:13px;border-radius:14px;background:#f7f9fc}
.label{font-size:12px;color:var(--muted)}.value{font-size:24px;font-weight:750;margin-top:5px}
.unitline{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#f7f9fc;border-radius:14px;padding:13px;margin-top:12px}
.warning{border:1px solid #ebcaca;background:#fff8f8;border-radius:14px;padding:12px;color:#613030;font-size:13px;line-height:1.45;margin-top:12px}
.note,.muted{font-size:12px;color:var(--muted)}
.hidden{display:none!important}.heightpair{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.drinkrow{border:1px solid var(--line);border-radius:13px;padding:11px;margin-top:8px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.drinkrow small{display:block;color:var(--muted);margin-top:3px}
</style>
</head>
<body>
<div class="wrap">
<h1>ClearTime</h1>
<p>Track drinks, UK alcohol units and a rough processing-time estimate.</p>

<section class="card">
<h2>Your details</h2>
<div class="grid">
<label>Weight (kg)<input id="weight" type="number" value="75"></label>

<div>
<label>Height</label>
<div class="switch" id="heightSwitch">
<button class="active" data-height="cm">cm</button>
<button data-height="ft">ft / in</button>
</div>
<input id="cm" type="number" value="175">
<div id="feetBox" class="heightpair hidden">
<input id="feet" type="number" value="5" placeholder="Feet">
<input id="inches" type="number" value="9" placeholder="Inches">
</div>
</div>

<label>Sex
<select id="sex">
<option>Male</option>
<option>Female</option>
<option>Prefer not to say</option>
</select>
</label>
</div>
</section>

<section class="card">
<h2>Add a drink</h2>

<div class="types" id="types">
<button class="active" data-type="lager">Lager</button>
<button data-type="cider">Cider</button>
<button data-type="vodka">Vodka</button>
<button data-type="gin">Gin</button>
<button data-type="wine">Wine</button>
<button data-type="other">Other</button>
</div>

<div class="grid">
<label>Brand<select id="brand"></select></label>
<label>Serving size<select id="serving"></select></label>
<label>Volume (ml)<input id="volume" type="number"></label>
<label>ABV (%)<input id="abv" type="number" step=".1">
<span class="note">Automatically updates for the selected drink. You can edit it if needed.</span></label>
</div>

<div class="unitline">
<div><span class="muted">This drink</span><br><strong><span id="units">0.00</span> units</strong></div>
<button id="add" class="primary">Add drink</button>
</div>
</section>

<section class="card">
<h2>Current session</h2>
<div class="stats">
<div class="stat"><div class="label">Drinks logged</div><div class="value" id="count">0</div></div>
<div class="stat"><div class="label">Total units</div><div class="value" id="total">0.00</div></div>
<div class="stat"><div class="label">Estimated alcohol-free by</div><div class="value" id="free">—</div></div>
</div>

<div class="warning"><strong>Estimate only.</strong> Alcohol processing varies between people. Do not use this estimate to decide whether you are safe or legal to drive, cycle, operate machinery, work at height, or perform any safety-critical activity.</div>

<div id="history"></div>
<button id="reset" style="margin-top:12px">Reset session</button>
</section>
</div>

<script>
const data={
lager:{
brands:[["Stella Artois",4.6],["Carling",4],["Foster's",3.7],["Carlsberg",3.4],["Carlsberg Export",4.8],["Peroni Nastro Azzurro",5],["Birra Moretti",4.6],["San Miguel",5],["Heineken",5],["Madri Excepcional",4.6],["Coors",4],["Corona Extra",4.5],["Budweiser",4.5],["Amstel",4.1],["Estrella Damm",4.6],["Camden Hells",4.6],["Tyskie",5],["Kronenbourg 1664",5],["Other lager",4.5]],
sizes:[["Half pint — 284 ml",284],["Pint — 568 ml",568],["330 ml",330],["440 ml",440],["500 ml",500]]
},
cider:{
brands:[["Strongbow Original",4.5],["Strongbow Dark Fruit",4],["Thatchers Gold",4.8],["Thatchers Haze",4.5],["Magners Original",4.5],["Kopparberg Mixed Fruit",4],["Kopparberg Strawberry & Lime",4],["Rekorderlig Strawberry-Lime",4],["Old Mout Berries & Cherries",4],["Inch's",4.5],["Aspall",5.5],["Bulmers Original",4.5],["Henry Westons Vintage",8.2],["Scrumpy Jack",6],["Other cider",4.5]],
sizes:[["Half pint — 284 ml",284],["Pint — 568 ml",568],["330 ml",330],["440 ml",440],["500 ml",500]]
},
vodka:{
brands:[["Smirnoff Red",37.5],["Absolut",40],["Grey Goose",40],["Cîroc",40],["Russian Standard",38],["Au Vodka",35.2],["Belvedere",40],["Ketel One",40],["Finlandia",40],["Other vodka",40]],
sizes:[["Single — 25 ml",25],["Double — 50 ml",50],["35 ml",35],["70 ml",70]]
},
gin:{
brands:[["Gordon's",37.5],["Bombay Sapphire",40],["Tanqueray",43.1],["Beefeater",40],["Hendrick's",41.4],["Whitley Neill",43],["Sipsmith",41.6],["Plymouth Gin",41.2],["Roku Gin",43],["Other gin",40]],
sizes:[["Single — 25 ml",25],["Double — 50 ml",50],["35 ml",35],["70 ml",70]]
},
wine:{
brands:[["House red wine",13],["House white wine",12.5],["House rosé wine",12],["Prosecco",11],["Champagne",12],["Sauvignon Blanc",12.5],["Pinot Grigio",12],["Chardonnay",13],["Malbec",13.5],["Merlot",13.5],["Cabernet Sauvignon",13.5],["Pinot Noir",13],["Rioja",13.5],["Other wine",12.5]],
sizes:[["Small glass — 125 ml",125],["Medium glass — 175 ml",175],["Large glass — 250 ml",250],["Bottle — 750 ml",750]]
},
other:{
brands:[["Guinness Draught",4.2],["John Smith's Extra Smooth",3.4],["BrewDog Punk IPA",5.4],["Camden Pale Ale",4],["WKD Blue",4],["Smirnoff Ice",4],["Jack Daniel's",40],["Jameson",40],["Bacardi Carta Blanca",37.5],["Captain Morgan Spiced Gold",35],["Malibu",21],["Baileys Original",17],["Disaronno",28],["Jägermeister",35],["Custom drink",5]],
sizes:[["25 ml",25],["35 ml",35],["50 ml",50],["70 ml",70],["125 ml",125],["175 ml",175],["250 ml",250],["284 ml",284],["330 ml",330],["440 ml",440],["500 ml",500],["Pint — 568 ml",568],["750 ml",750]]
}
};

const $=x=>document.getElementById(x);
let current="lager",drinks=[];

function load(type){
current=type;
document.querySelectorAll("#types button").forEach(b=>b.classList.toggle("active",b.dataset.type===type));

$("brand").innerHTML="";
data[type].brands.forEach(([name,a])=>{
let o=document.createElement("option");
o.textContent=name+" — "+a+"%";
o.value=name;o.dataset.abv=a;$("brand").appendChild(o);
});

$("serving").innerHTML="";
data[type].sizes.forEach(([name,v])=>{
let o=document.createElement("option");
o.textContent=name;o.value=v;$("serving").appendChild(o);
});

if(type==="lager"||type==="cider"){
$("serving").value="568";$("volume").value=568;
}else{
$("volume").value=data[type].sizes[0][1];
}
$("abv").value=$("brand").options[0].dataset.abv;
calc();
}

function calc(){
$("units").textContent=((+$("volume").value||0)*(+$("abv").value||0)/1000).toFixed(2);
}

document.querySelectorAll("#types button").forEach(b=>b.onclick=()=>load(b.dataset.type));

$("brand").onchange=()=>{
$("abv").value=$("brand").options[$("brand").selectedIndex].dataset.abv;
calc();
};

$("serving").onchange=()=>{$("volume").value=$("serving").value;calc()};
$("volume").oninput=calc;$("abv").oninput=calc;

document.querySelectorAll("#heightSwitch button").forEach(b=>b.onclick=()=>{
document.querySelectorAll("#heightSwitch button").forEach(x=>x.classList.toggle("active",x===b));
if(b.dataset.height==="ft"){
let inches=(+$("cm").value||175)/2.54;
$("feet").value=Math.floor(inches/12);
$("inches").value=Math.round(inches%12);
$("cm").classList.add("hidden");$("feetBox").classList.remove("hidden");
}else{
$("cm").value=Math.round(((+$("feet").value*12)+ +$("inches").value)*2.54);
$("feetBox").classList.add("hidden");$("cm").classList.remove("hidden");
}
});

function render(){
let total=drinks.reduce((s,d)=>s+d.units,0);
$("count").textContent=drinks.length;
$("total").textContent=total.toFixed(2);

if(total){
let time=new Date(Date.now()+Math.ceil(total*60)*60000);
$("free").textContent=time.toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});
}else $("free").textContent="—";

$("history").innerHTML="";
drinks.forEach((d,i)=>{
let row=document.createElement("div");
row.className="drinkrow";
row.innerHTML="<div><strong>"+d.name+"</strong><small>"+d.volume+" ml · "+d.abv+"% · "+d.units.toFixed(2)+" units</small></div>";
let button=document.createElement("button");
button.textContent="Remove";
button.onclick=()=>{drinks.splice(i,1);render()};
row.appendChild(button);$("history").appendChild(row);
});
}

$("add").onclick=()=>{
let volume=+$("volume").value,abv=+$("abv").value;
if(volume>0&&abv>0){
drinks.push({name:$("brand").value,volume,abv,units:volume*abv/1000});
render();
}
};

$("reset").onclick=()=>{drinks=[];render()};
load("lager");render();
</script>
</body>
</html>
